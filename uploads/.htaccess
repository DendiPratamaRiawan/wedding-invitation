# Folder unggahan: hanya berkas statis, tanpa eksekusi skrip.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|phar|php\d|pl|py|cgi|sh|html?|svg|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=2592000"
</IfModule>
